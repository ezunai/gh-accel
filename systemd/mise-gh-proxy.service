[Unit]
Description=mise GitHub 下载加速代理（国内镜像优先 + 多级回退）
Documentation=file:%h/Code/personal/mise-gh-proxy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Code/personal/mise-gh-proxy
Environment=PYTHONPATH=%h/Code/personal/mise-gh-proxy/src
ExecStart=/usr/bin/python3 -m mise_gh_proxy
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
